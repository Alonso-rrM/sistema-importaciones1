# =====================================================================
# CONFIGURACIÓN DEL BACKEND (copiar este archivo como .env y completarlo)
#   cp .env.example .env
# El archivo .env NO se sube al repositorio (está en .gitignore).
# =====================================================================

# --- Obligatorias ----------------------------------------------------

# Base de datos PostgreSQL: postgresql://usuario:clave@servidor:puerto/nombre_base
DATABASE_URL=postgresql://usuario:clave@localhost:5432/importaciones

# Clave para firmar las sesiones. Use un texto largo y aleatorio, distinto en cada instalación.
# Para generar una:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# --- Sesión y acceso -------------------------------------------------

# Minutos que dura una sesión antes de pedir nuevamente usuario y clave
ACCESS_TOKEN_EXPIRE_MINUTES=60

# true solo si el sistema se sirve por HTTPS. En la red local por HTTP debe quedar en false
# (si no, el navegador no guarda la sesión).
COOKIE_SECURE=false

# Direcciones desde las que se abre el frontend, separadas por comas (si no se define:
# http://localhost:5173 y http://127.0.0.1:5173). Con el proxy de Vite (/api) normalmente no hace falta.
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# Documentación interactiva de la API en /docs (solo para desarrollo)
ENABLE_DOCS=false

# --- Consulta de RUC a SUNAT (ApiPeru) -------------------------------

# Token de https://apiperu.dev. Sin él, el botón "Validar SUNAT" responde que no está configurado.
SUNAT_API_TOKEN=

# --- Controles de pagos y tipo de cambio (opcionales) ----------------
# Los valores indicados son los que se usan si la variable no se define.

# Diferencia máxima que puede cobrar el banco sobre el débito teórico en pagos con moneda cruzada
# MARGEN_SPREAD_BANCARIO=0.05
# Banda permitida del tipo de cambio de un pago respecto al TC oficial SUNAT del día
# MARGEN_TC_OFICIAL=0.05
# Banda de control del tipo de cambio cuando no hay TC oficial registrado
# TC_MINIMO=2.50
# TC_MAXIMO=5.50
# Tiempo máximo que un pago espera a que otro pago termine con el mismo gasto o voucher
# LOCK_TIMEOUT_PAGOS=5s

# --- Usuario administrador inicial (scripts/seed_inicial.py y scripts/cargar_plantillas.py) ---
# Alternativa a la pantalla /setup. Tras crear el usuario, puede borrar ADMIN_PASSWORD de este archivo.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@sistema.local
# URL del backend para scripts/cargar_plantillas.py
# API_URL=http://localhost:8000

# --- Pruebas (no son necesarias para usar el sistema) ----------------
# Bases DESECHABLES (su nombre debe contener "test"): las pruebas borran todo su contenido.
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/importaciones_test
# E2E_DATABASE_URL=postgresql://usuario:clave@localhost:5432/importaciones_e2e_test
